# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json
debug.log

# Exclude macOS Finder (System Explorer) View States
.DS_Store
/.devbox/
/states/
/jobs/
/locks/

# Demo vault: tracked by allowlist only. Everything else in it stays untracked,
# including downloaded minis (whatever the download path is set to), workspace
# state and any other plugins.
/demo-vault/*
!/demo-vault/Welcome.md
!/demo-vault/.obsidian/
/demo-vault/.obsidian/*
!/demo-vault/.obsidian/app.json
!/demo-vault/.obsidian/appearance.json
!/demo-vault/.obsidian/community-plugins.json
!/demo-vault/.obsidian/core-plugins.json
!/demo-vault/.obsidian/plugins/
/demo-vault/.obsidian/plugins/*
!/demo-vault/.obsidian/plugins/mini-manager

# jest
/coverage/
